# ---------------------------------------------------------------------------
# Mastana International
# Copy to `.env` and fill in. Every value here is optional for local dev:
# without DATABASE_URL the site renders from src/content/catalog.json and
# writes submissions to .data/*.jsonl; without OPENAI_API_KEY the assistant
# answers from the retrieval layer alone.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mastana?schema=public"

# Server-side only. Never exposed to the browser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Canonical site URL, used for metadata, sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL="https://mastanaintl.com"
